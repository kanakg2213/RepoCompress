  });

  it('should handle errors from worker', async () => {
    const content = 'test content';
    const encoding = 'o200k_base';
    const mockError = new Error('Worker error');

    const mockErrorTaskRunner = (_options: WorkerOptions): MetricsTaskRunner => {
      return {
        run: async () => {
