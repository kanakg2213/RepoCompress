        processedFiles: [],
        safeFilePaths: [],
        gitDiffTokenCount: 0,
        gitLogTokenCount: 0,
        skippedFiles: [],
      };

      reportSummary('/test/project', packResult, config);

      expect(logger.log).toHaveBeenCalledWith(expect.stringContaining('1 suspicious file(s) detected and excluded'));
    });

    test('should print summary with git diffs included', () => {
