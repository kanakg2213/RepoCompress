      }

      // Greet implements the Greeter interface
      func (u User) Greet() string {
        return fmt.Sprintf("Hello, I'm %s!", u.Name)
      }

      // Main entry point
      func main() {
        user := User{Name: "John", Age: 30}
        fmt.Println(user.Greet())
        SayHello(os.Args[1])
      }
