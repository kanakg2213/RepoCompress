      expect(logger.log).toHaveBeenCalledWith(expect.stringContaining('Git diffs included'));
      expect(logger.log).toHaveBeenCalledWith(expect.stringContaining('50 tokens'));
    });

    test('should print summary with no git diffs', () => {
